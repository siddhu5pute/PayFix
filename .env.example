# Copy to .env (never commit .env). Every value is optional: with no .env at all,
# the demo runs fully offline against MockPay (a Razorpay-compatible test gateway).

# ---- Gateway: leave these commented out to use MockPay ----
# To use the REAL Razorpay sandbox (Test Mode only, keys start with rzp_test_):
# GATEWAY_MODE=razorpay
# RAZORPAY_API_BASE=https://api.razorpay.com/v1
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=        # any long random string; same value in Razorpay Dashboard > Webhooks

# ---- Service-to-service key (portal internal API) ----
INTERNAL_API_KEY=change-me-to-a-long-random-string

# ---- Database passwords ----
PORTAL_DB_PASSWORD=portal
ENGINE_DB_PASSWORD=engine

# ---- Portal failure-injection flags (also switchable live in the Control Room) ----
DROP_WEBHOOKS=false
DELAY_WEBHOOK_SECONDS=0
DUPLICATE_WEBHOOKS=false

# ---- Reconciliation engine ----
RECON_INTERVAL_SECONDS=10
MIN_AGE_SECONDS=20
ABANDON_AFTER_SECONDS=120
DRY_RUN=false

# ---- Demo mode: lets the Control Room flip flags without an admin key ----
DEMO_MODE=true
# ADMIN_KEY=

# ---- ngrok (only for real Razorpay webhooks): dashboard.ngrok.com -> Your Authtoken ----
# NGROK_AUTHTOKEN=
